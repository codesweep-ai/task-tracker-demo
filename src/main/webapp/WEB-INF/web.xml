<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>task-tracker</display-name>

  <!-- Bootstrap the in-memory DB on startup -->
  <listener>
    <listener-class>com.acme.tracker.db.BootstrapListener</listener-class>
  </listener>

  <!-- Servlet filter -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.acme.tracker.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- ── Servlets (routing lives here, not in annotations) ── -->
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>com.acme.tracker.web.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>logout</servlet-name>
    <servlet-class>com.acme.tracker.web.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>logout</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>tasks</servlet-name>
    <servlet-class>com.acme.tracker.web.TaskListServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>tasks</servlet-name>
    <url-pattern>/tasks</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>taskForm</servlet-name>
    <servlet-class>com.acme.tracker.web.TaskFormServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>taskForm</servlet-name>
    <url-pattern>/tasks/form</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>taskAction</servlet-name>
    <servlet-class>com.acme.tracker.web.TaskActionServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>taskAction</servlet-name>
    <url-pattern>/tasks/action</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>projects</servlet-name>
    <servlet-class>com.acme.tracker.web.ProjectServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>projects</servlet-name>
    <url-pattern>/projects</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>apiTasks</servlet-name>
    <servlet-class>com.acme.tracker.web.ApiTaskServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>apiTasks</servlet-name>
    <url-pattern>/api/tasks</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
</web-app>
